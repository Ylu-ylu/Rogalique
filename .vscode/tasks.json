{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build XYZRoguelike Release x64",
            "type": "shell",
            "command": "${workspaceFolder}\\Build.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds Game.sln via MSBuild using the repository build script."
        }
    ]
}
